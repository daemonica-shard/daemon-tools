# Copy to .env on the server.
DOMAIN=example.com
# GitHub owner of the ghcr.io images (lowercase org/user), e.g. daemonica-shard
GHCR_OWNER=example-org

# Keycloak (Google-sign-in tier). Realm name is part of the OIDC issuer URL, so
# changing it after clients are connected invalidates their configuration.
KC_REALM=daemonica
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
KC_DB_PASSWORD=change-me
