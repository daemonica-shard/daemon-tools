# Copy to .env on the server.
DOMAIN=example.com
# GitHub owner of the ghcr.io images (lowercase org/user), e.g. daemonica-shard
GHCR_OWNER=example-org

# Keycloak (Google-sign-in tier). Realm name is part of the OIDC issuer URL, so
# changing it after clients are connected invalidates their configuration.
KC_REALM=daemonica
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
KC_DB_PASSWORD=change-me

# Metrics stack (Prometheus + Grafana).
# Bearer token every Claude Code client presents to push metrics. One shared value, not per
# user — it authorises writing to a metrics store, nothing else. `openssl rand -hex 32`.
# Replace before exposing `otel.`: this file is in a PUBLIC repo, so until you do, the literal
# token below is one anybody can read.
OTEL_INGEST_TOKEN=change-me
# Client secret of the `grafana` client in the Keycloak realm (Clients → grafana → Credentials).
GRAFANA_OIDC_SECRET=change-me
# Local Grafana admin, the way back in when OIDC or Keycloak is broken.
GRAFANA_ADMIN_PASSWORD=change-me
