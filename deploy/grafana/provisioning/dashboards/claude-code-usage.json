{
  "uid": "claude-code-usage",
  "title": "Claude Code usage",
  "description": "Usage history from jobs/claude-usage (transcripts, exact) plus live activity from Claude Code's OTLP export. The live counters are per-session: each session starts at zero and its series disappears 5 minutes after the session ends, so sums over them are meaningless \u2014 increase() overcounts by extrapolating short-lived series, last_over_time undercounts by missing finished ones. Totals therefore come from the archive; live metrics show shape only.",
  "tags": [
    "claude",
    "usage"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tokens",
      "description": "Exact figure, reconstructed from Claude Code transcripts by jobs/claude-usage. Not derived from the live counters, which reset every session.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(claude_usage_archive_daily_tokens[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost",
      "description": "Exact figure, reconstructed from Claude Code transcripts by jobs/claude-usage. Not derived from the live counters, which reset every session.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(claude_usage_archive_daily_cost_USD[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Output tokens",
      "description": "Output is the honest measure of work done. Cache reads dwarf everything by volume and cost a fraction, so a total-token figure mostly measures context size. Exact figure, reconstructed from Claude Code transcripts by jobs/claude-usage. Not derived from the live counters, which reset every session.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(claude_usage_archive_daily_tokens{type=\"output\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Days recorded",
      "description": "How many days of archive fall in the selected range \u2014 a sanity check that the window contains what you think it does.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(count_over_time(claude_usage_archive_daily_cost_USD[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens per day by type",
      "description": "Exact figure, reconstructed from Claude Code transcripts by jobs/claude-usage. Not derived from the live counters, which reset every session.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (last_over_time(claude_usage_archive_daily_tokens[1d]))",
          "interval": "1d",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost per day",
      "description": "Exact figure, reconstructed from Claude Code transcripts by jobs/claude-usage. Not derived from the live counters, which reset every session.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time(claude_usage_archive_daily_cost_USD[1d]))",
          "interval": "1d",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Output tokens per day by model",
      "description": "Exact figure, reconstructed from Claude Code transcripts by jobs/claude-usage. Not derived from the live counters, which reset every session.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (last_over_time(claude_usage_archive_daily_tokens{type=\"output\"}[1d]))",
          "interval": "1d",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Live activity \u2014 tokens/sec by model",
      "description": "Live OTLP, rate over a short window \u2014 the one thing these counters do reliably. They reset per session, so they cannot produce trustworthy totals; use the archive panels for that.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(claude_code_token_usage_tokens_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    }
  ]
}